# MetaMCP Environment Configuration
# Copy to .env and customize for your environment

# Server binding
HOST=127.0.0.1
PORT=10718

# API auth for protected write/analysis routes (required if you enable those paths)
# Generate a long random string; never commit the real value.
WURST_AUTH_TOKEN=change-me-before-use

# Fleet repo scan root (required for manifest refresh / launch)
FLEET_REPOS_ROOT=/path/to/repos
# Alias accepted by some tools:
REPOS_DIR=/path/to/repos

# MetaMCP dashboard (open_mcp_launcher default)
META_MCP_WEB_URL=http://127.0.0.1:10719/
# META_MCP_START_PS1=/path/to/meta_mcp/web_sota/start.ps1

# Local fleet state (manifests, reports, optional MASTER config copy)
# META_MCP_FLEET_DEPOT=%USERPROFILE%\.meta_mcp\fleet
# META_MCP_FLEET_MANIFESTS_DIR=
# META_MCP_FLEET_REPORTS_DIR=

# Optional handbook clone — NOT required for runtime (export / legacy scripts only)
# MCP_CENTRAL_DOCS_ROOT=/path/to/mcp-central-docs

# Optional: override hostname in heartbeat/pulse output (default: OS hostname)
# META_MCP_NODE_LABEL=local

# Analysis depot (local archive)
META_MCP_ANALYSIS_DEPOT=%USERPROFILE%\.meta_mcp\analysis
META_MCP_ANALYSIS_CACHE_TTL=86400

# MCP bridge URLs for cross-server discovery (comma-separated)
MCP_BRIDGE_URLS=

# Master config path (optional; defaults to ~/.meta_mcp/fleet/MASTER_MCP_CONFIG.json)
META_MCP_MASTER_CONFIG=

# Optional overrides (all default to portable repo-relative paths)
# META_MCP_TASKS_FILE=/path/to/tasks.json
# META_MCP_FULLSTACK_SCRIPT=/path/to/fullstack-builder.ps1
# META_MCP_WEBSHOP_SCRIPT=/path/to/webshop-builder.ps1

# Logging
FASTMCP_LOG_LEVEL=WARNING
